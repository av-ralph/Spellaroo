# The path to the 'Generated.xcconfig' and 'generated_helper.rb'
# This is the standard way Flutter loads its helper scripts
platform :ios, '13.0'

# Standard Flutter helper loading logic
flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__)) rescue nil

# If the above fails, we use a more manual require as a fallback
if !defined?(flutter_install_all_ios_pods)
  begin
    require File.expand_path(File.join('..', 'Flutter', 'generated_helper.rb'), __FILE__)
  rescue LoadError
    begin
      require File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'generated_helper.rb'), __FILE__)
    rescue LoadError
      # This will be handled by the build tool usually
    end
  end
end

# Flutter Google Fonts requires this
install! 'cocoapods', :deterministic_uuids => false

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Fix for signing issues on some platforms
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 arm64'
    end
  end
end
