# The path to the 'Generated.xcconfig' and 'generated_helper.rb'
# We use a rescue block to handle cases where the file isn't generated yet
begin
  require File.expand_path(File.join('..', 'Flutter', 'generated_helper.rb'), __FILE__)
rescue LoadError
  # Fallback for newer Flutter versions where it might be in 'ephemeral'
  begin
    require File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'generated_helper.rb'), __FILE__)
  rescue LoadError
    puts "Warning: generated_helper.rb not found. Run 'flutter pub get' first."
  end
end

# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# Flutter Google Fonts requires this
install! 'cocoapods', :deterministic_uuids => false

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Fix for signing issues on some platforms
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 arm64'
    end
  end
end
